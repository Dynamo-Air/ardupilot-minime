# AS-10 MiniMe Flight Test Parameters
# For flight operations after Phase W and Phase G validation
#
# WARNING: DO NOT FLY UNTIL ALL TBD VALUES ARE RESOLVED
# All TBD parameters must be populated from Phase W HIL validation
# and Phase G ground vibration test results before first flight.
#
# TBD Resolution Checklist:
#   [ ] ATC_RAT_RLL_P/I/D resolved from Phase W HIL
#   [ ] ATC_RAT_PIT_P/I/D resolved from Phase W HIL
#   [ ] ATC_RAT_YAW_P/I/D resolved from Phase W HIL
#   [ ] H_RSC_THRCRV_* resolved from Phase W whirl stand
#   [ ] H_RSC_GOV_* resolved from Phase W whirl stand
#   [ ] RPM avoidance bands uploaded from Phase G results
#   [ ] H_COLYAW sign verified during Phase T
#   [ ] ATC_RAT_RLL_MAX refined empirically during Phase T/F0

# =============================================================================
# BASELINE PARAMETERS (from minime_baseline.param)
# =============================================================================

# Frame Configuration
FRAME_CLASS,11
H_FLYBAR_MODE,0
H_SW_TYPE,0
H_DUAL_MODE,0

# Collective Servo PWM Limits (forward rotor)
# These are PWM values for servo endpoints, not blade pitch angles
H_COL_MIN,1250
H_COL_MAX,1750

# Maximum Cyclic Blade Pitch (degrees)
H_CYC_MAX,7.0

# Blade Pitch Angles (degrees corresponding to H_COL_MIN and H_COL_MAX PWM values)
# Required for arming and proper collective scaling
H_COL_ANG_MIN,-2.0
H_COL_ANG_MAX,12.0

# Governor Configuration
# Uses ESC governor mode for flight (H_RSC_MODE = 2)
# H_RSC_SETPOINT is throttle percentage (0 to 100), not RPM
# Actual RPM target (1074.2) must be configured on DTI HV550 via DTI CAN Tool (requires DTI-COM adapter)
# Test modes use H_RSC_MODE = 3 (throttle curve)
H_RSC_MODE,2
H_RSC_SETPOINT,70

# Autorotation Parameters
H_RSC_AROT_ENBL,1
H_RSC_AROT_IDLE,0
H_RSC_AROT_RAMP,1.5

# Differential Control Parameters
H_DCP_SCALER,0
H_YAW_SCALER,5.6
# H_COLYAW sign to be verified during Phase T; flip if yaw coupling worsens
H_COLYAW,0.10

# CAN Bus Configuration
CAN_P1_DRIVER,1
CAN_D1_PROTOCOL,10
CAN_P1_BITRATE,500000

# GPIO Configuration for HV Control
# AUX1 (GPIO 50): Forward main contactor
SERVO9_FUNCTION,-1
# AUX2 (GPIO 51): Forward precharge
SERVO10_FUNCTION,-1
# AUX3 (GPIO 52): Aft main contactor
SERVO11_FUNCTION,-1
# AUX4 (GPIO 53): Aft precharge
SERVO12_FUNCTION,-1
# AUX5 (GPIO 54): Forward STO signal
SERVO13_FUNCTION,-1
# AUX6 (GPIO 55): Aft STO signal
SERVO14_FUNCTION,-1

# Failsafe Configuration
FS_THR_ENABLE,4
RC_FS_TIMEOUT,1.0
FS_GCS_ENABLE,1
FS_GCS_TIMEOUT,5
FS_EKF_ACTION,1
FS_EKF_THRESH,0.8
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1
BATT_LOW_TIMER,10

# Battery Voltage Thresholds
BATT_LOW_VOLT,126.0
BATT_CRT_VOLT,118.8

# Geofence Configuration
FENCE_ENABLE,1
FENCE_TYPE,7
FENCE_ACTION,1

# Logging Configuration
# LOG_BITMASK = 176126 enables ATT, GPS, PM, CTUN, NTUN, RCIN, IMU, CMD,
# CURRENT, RCOU (servo output), OPTFLOW, COMPASS, CAMERA, MOTBATT
# PM messages required for OBJ-FCS-4 frame timing verification
LOG_BITMASK,176126
LOG_DISARMED,1

# =============================================================================
# ATTITUDE RATE CONTROLLER LIMITS
# =============================================================================

# Roll Rate Limit
# First flight conservative value; increase empirically to 90 deg/s during Phase T/F0
# Very responsive axis due to low Ixx = 8.54 kg m squared
ATC_RAT_RLL_MAX,60

# Pitch Rate Limit
# Current: Aluminum mast, SF > 1.0 at 30 deg/s
# Upgrade: Steel 4340 mast supports 57.3 deg/s with SF > 3.0
# For upgrade procedure see: docs/minime/MAST_UPGRADE_PROCEDURE.md
ATC_RAT_PIT_MAX,30

# Yaw Rate Limit
# Authority limited due to eta_yaw = 0.30 reduction factor
ATC_RAT_YAW_MAX,15

