# AS-10 MiniMe Bench Test Parameters
# WARNING: DO NOT USE FOR FLIGHT
# This file disables safety checks and failsafes for controlled bench testing only
# For flight operations use minime_flight.param

# =============================================================================
# BASELINE PARAMETERS (from minime_baseline.param)
# =============================================================================

# Frame Configuration
FRAME_CLASS,6
H_FLYBAR_MODE,0
H_SW_TYPE,0
H_DUAL_MODE,1

# Blade Pitch Limits
H_COL_MIN,-2.0
H_COL_MAX,12.0
H_CYC_MAX,7.0

# Autorotation Parameters
H_RSC_AROT_ENBL,1
H_RSC_AROT_IDLE,0
H_RSC_AROT_RAMP,1.5

# Differential Control Parameters
H_DCP_SCALER,0
H_YAW_SCALER,5.6
H_COLYAW,0.09

# Attitude Rate Controller Limits
ATC_RAT_RLL_MAX,60
ATC_RAT_PIT_MAX,30
ATC_RAT_YAW_MAX,15

# CAN Bus Configuration
CAN_P1_DRIVER,1
CAN_D1_PROTOCOL,10
CAN_D1_BITRATE,500000

# GPIO Configuration for HV Control
SERVO9_FUNCTION,-1
SERVO10_FUNCTION,-1
SERVO11_FUNCTION,-1
SERVO12_FUNCTION,-1
SERVO13_FUNCTION,-1
SERVO14_FUNCTION,-1

# Battery Voltage Thresholds
BATT_LOW_VOLT,126.0
BATT_CRT_VOLT,118.8

# =============================================================================
# BENCH TEST OVERRIDES
# =============================================================================

# Arming Check: Disabled for bench testing without GPS
# WARNING: Re-enable for flight (ARMING_CHECK,1)
ARMING_CHECK,0

# Governor Configuration: Throttle curve mode for test modes
# Baseline uses H_RSC_MODE = 2 (ESC governor)
# Test modes (OBJ-MOD-4, OBJ-MOD-5) require H_RSC_MODE = 3 (throttle curve)
# Test modes require throttle curve mode
H_RSC_MODE,3
H_RSC_SETPOINT,1131.7

# Failsafe Configuration: Disabled for controlled bench environment
# WARNING: Re-enable all failsafes for flight
FS_THR_ENABLE,0
RC_FS_TIMEOUT,1.0
FS_GCS_ENABLE,0
FS_GCS_TIMEOUT,5
FS_EKF_ACTION,1
FS_EKF_THRESH,0.8
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1
BATT_LOW_TIMER,10

# Geofence: Disabled for indoor bench testing
# WARNING: Re-enable for flight (FENCE_ENABLE,1)
FENCE_ENABLE,0
FENCE_TYPE,7
FENCE_ACTION,1

# =============================================================================
# DEBUG AND LOGGING CONFIGURATION
# =============================================================================

# Logging: All messages enabled for bench test analysis
# LOG_BITMASK = 524287 enables all log types
# Baseline uses 176126 which is adequate for flight
LOG_BITMASK,524287
LOG_DISARMED,1

# Lua Script Debugging: Verbose output for development
# SCR_DEBUG_LVL = 2 enables verbose script debug messages
SCR_DEBUG_LVL,2

# Lua Scripting: Enable with adequate heap for all scripts
SCR_ENABLE,1
SCR_HEAP_SIZE,65536
